server {
    listen {{ aptly_listen_http }};
    server_name {{ aptly_domain }};

{% if aptly_tls_enabled %}
    return 301 https://$host$request_uri;
}

server {
    listen {{ aptly_listen_https }} ssl http2;
    server_name {{ aptly_domain }};

    ssl_certificate     {{ aptly_tls_cert_path }};
    ssl_certificate_key {{ aptly_tls_key_path }};

{% endif %}
    root {{ aptly_public_dir }};
    autoindex on;

    location / {
        try_files $uri $uri/ =404;
    }

{% if aptly_api_enabled %}
    location /api/ {
        proxy_pass http://{{ aptly_api_listen_host }}:{{ aptly_api_listen_port }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
{% endif %}
}
